# Copy to .env.local (git-ignored) for local dev; in Amplify Hosting set them as environment variables.
# Leave the Cognito values empty to run without login against the Spring "local" profile.
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=
# API Gateway invoke URL, e.g. https://abc123.execute-api.us-east-1.amazonaws.com ; empty = same origin (Vite proxy)
VITE_API_URL=
